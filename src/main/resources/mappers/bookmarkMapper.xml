<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
 "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
 
 <mapper namespace="com.maeun.spring.test.ajax.repository.BookmarkRepository">
 	<insert id="insertBookmark" parameterType="map">
 		INSERT INTO
 			`bookmark`
 		(
 			`name`
 			, `url`
 		)
 		VALUE
 		(
 			#{name}
 			, #{url}
 		)
 	</insert>
 	<select id="selectBookmark" resultType="com.maeun.spring.test.ajax.domain.Bookmark">
 		SELECT
 			`id`
 			, `name`
 			, `url`
 		FROM
 			`bookmark`
 	</select>
 	<select id="selectDuplicateByUrl"
 	resultType="int" parameterType="string">
 		SELECT
 			count(*)
 		FROM
 			`bookmark`
 		WHERE
 			`url` = #{url}
 	</select>
 </mapper>
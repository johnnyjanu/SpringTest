<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
 "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
 
 <mapper namespace="com.maeun.spring.test.ajax.repository.BookingRepository">
 	<select id="selectBooking"
 	resultType="com.maeun.spring.test.ajax.domain.Booking">
 		SELECT
 			`id`
 			, `name`
 			, `headcount`
 			, `day`
 			, `date`
 			, `phoneNumber`
 			, `state`
 		FROM
 			`booking`
 		ORDER BY
 			`date`
 	</select>
 	<delete id="deleteBooking"
 	parameterType="int">
 		DELETE FROM
 			`booking`
 		WHERE
 			`id` = #{id}
 	</delete>
 	<insert id="insertBooking"
 	parameterType="map">
 		INSERT INTO
 			`booking`
 		(
 			`name`
 			, `headcount`
 			, `day`
 			, `date`
 			, `phoneNumber`
 			, `state`
 		)
 		VALUE
 		(
 			#{name}
 			, #{headcount}
 			, #{day}
 			, #{date}
 			, #{phoneNumber}
 			, #{state}
 		)
 	</insert>
 	<select id="selectBookingByInform"
 	parameterType="map" resultType="map">
 		SELECT
 			`name`
 			, `headcount`
 			, `day`
 			, `date`
 			, `state`
 		FROM
 			`booking`
 		WHERE
 			`name` = #{name} AND `phoneNumber` = {phoneNumber}
 	</select>
 	
 </mapper>
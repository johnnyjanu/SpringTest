<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
 "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
 
<mapper namespace="com.maeun.spring.test.mvc.repository.SellerRepository">

	<insert id="insertSeller" parameterType="map">
		INSERT INTO
			`seller`
		(
			`nickname`
			, `temperature`
			, `profileImage`
		)
		VALUE
		(
			#{nickname}
			, #{temperature}
			, #{profileImage}
		)
	</insert>
	<!-- 
	<insert id="insertSellerObject" parameterType="com.maeun.spring.test.mvc.domain.Seller"
	useGeneratedKeys="true" keyProperty="id">
		INSERT INTO
			`seller`
		(
			`nickname`
			, `temperature`
			, `profileImage`
		)
		VALUE
		(
			#{nickname}
			, #{temperature}
			, #{profileImage}
		)
	</insert>
	 -->
	<select id="selectLastSeller"
	resultType="com.maeun.spring.test.mvc.domain.Seller">
		SELECT
			`id`
			, `nickname`
			, `temperature`
			, `profileImage`
			, `createdAt`
			, `updatedAt`
		FROM
			`Seller`
		ORDER BY
			`id` DESC
		LIMIT
			1
	</select>
	<select id="selectSeller"
	resultType="com.maeun.spring.test.mvc.domain.Seller">
		SELECT
			`id`
			, `nickname`
			, `temperature`
			, `profileImage`
			, `createdAt`
			, `updatedAt`
		FROM
			`Seller`
		WHERE
			`id` = #{id}
	</select>
	
</mapper>
<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
 "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
 
 <mapper namespace="com.maeun.spring.test.thymeleaf.repository.WeatherRepository">
 	<select id="selectWeather"
 	resultType="com.maeun.spring.test.thymeleaf.domain.WeatherHistory">
 		SELECT
 			`id`
 			, `date`
 			, `weather`
 			, `temperatures`
 			, `precipitation`
 			, `microDust`
 			, `windSpeed`
 			, `createdAt`
 			, `updatedAt`
 		FROM
 			`weatherhistory`
 		ORDER BY
 			`date`
 	</select>
 	<insert id="insertWeather"
 	parameterType="com.maeun.spring.test.thymeleaf.domain.WeatherHistory">
 		INSERT INTO
 			`weatherhistory`
 		(
 			`date`
 			, `weather`
 			, `temperatures`
 			, `precipitation`
 			, `microDust`
 			, `windSpeed`
 		)
 		VALUE
 		(
 			#{date}
 			, #{weather}
 			, #{temperatures}
 			, #{precipitation}
 			, #{microDust}
 			, #{windSpeed}
 		)
 	</insert>
 	
 </mapper>